# Copy this file to .env and fill in real values before running the app.

# General
ENVIRONMENT=development
DEBUG=true

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=asiatech_sentiment_db

# Security
SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma-separated list is parsed by pydantic-settings as JSON array
# if you prefer; simplest is to edit CORS_ORIGINS default in config.py)

# ML
BERT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment
BERT_DEVICE=cpu
