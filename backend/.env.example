# Copy this file to .env and fill in real values before running the app.

# General
ENVIRONMENT=production
DEBUG=false

# Database (MySQL)
DB_HOST=your-production-db-host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_strong_db_password
DB_NAME=asiatech_sentiment_db

# Security
SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS: use the exact public frontend origin(s) only.
# Example: CORS_ORIGINS=https://feedback.asiatech.edu.ph,https://www.asiatech.edu.ph
CORS_ORIGINS=https://your-frontend-domain.example

# ML
TRANSFORMER_DEVICE=cpu

# ---------------------------------------------------------------------------
# Live sentiment model: mBERT Hybrid
# ---------------------------------------------------------------------------
# Read token for the HuggingFace repo holding the mBERT Hybrid artifacts
# (frozen bert-base-multilingual-cased encoder + scikit-learn hybrid head).
# The ~711 MB of weights are NOT committed to git, so the startup downloader
# (app/services/hub_downloader.py) needs this token on a fresh host. Leave it
# empty only when the artifacts are already present in app/ml/mbert_hybrid/.
HF_TOKEN=
HF_MBERT_REPO=rowseiy/mbert-sentiment

# Memory guard. The fp32 encoder costs ~1.6-2.0 GB RSS PER GUNICORN WORKER, so
# the shipped 2-worker config needs a host with >= 4 GB. A host reporting less
# than this value refuses inference and every prediction returns 503 (mBERT is
# the only live model - there is no fallback). Set to 0 to disable the guard,
# but only on a host that genuinely has the memory.
MBERT_MIN_RAM_MB=2048

# Set to false to disable live inference entirely (all predictions 503).
ENABLE_MBERT_INFERENCE=true
