# ============================================================
# .env.example — Asiatech Sentiment Analysis Backend
# Copy to backend/.env and fill in real values.
# (pydantic-settings loads backend/.env — see app/core/config.py:32)
# All values below are FAKE PLACEHOLDERS. Replace everything.
# ============================================================

# ------------------------------------------------------------
# App / Server
# ------------------------------------------------------------

# Display name of the API (docs/metadata) — backend/app/core/config.py
PROJECT_NAME=your_project_name_here

# API description shown in OpenAPI docs — backend/app/core/config.py
PROJECT_DESCRIPTION=your_project_description_here

# Application version string — backend/app/core/config.py
VERSION=your_version_here

# URL prefix for the v1 API router — backend/app/core/config.py
API_V1_PREFIX=your_api_prefix_here

# development | production — gates production guards, reset-email sending — backend/app/core/config.py
ENVIRONMENT=development

# Debug flag; accepts true/false or "debug"/"release" labels — backend/app/core/config.py
DEBUG=false

# Enable uvicorn auto-reload in root launcher run.py (1/true/yes/on) — run.py
APP_RELOAD=false

# Default API rate limit — backend/app/core/limiter.py via backend/app/core/config.py
RATE_LIMIT_DEFAULT=100/minute

# Rate limit for prediction endpoints — backend/app/core/config.py
RATE_LIMIT_PREDICT=20/minute

# Rate limit for auth endpoints — backend/app/core/config.py
RATE_LIMIT_AUTH=10/minute

# Minimum answered Likert questions per submission — backend/app/api/evaluation.py via backend/app/core/config.py
LIKERT_MIN_QUESTIONS=5

# Confidence below this counts as "low confidence" in analytics — backend/app/api/analytics.py via backend/app/core/config.py
LOW_CONFIDENCE_THRESHOLD=0.5

# JSON list of grading-term buckets for the academic-term chart — backend/app/api/analytics.py via backend/app/core/config.py
# Example shape: [{"term": "Term 1 Prelim", "months": [7]}]
ACADEMIC_TERM_MONTHS=your_json_term_months_here

# Allowed CORS origins. Comma-separated string or JSON list. Blocks startup in production if empty/* /localhost.
# REQUIRED, no default found — app fails ValidationError at import time without it — backend/app/main.py via backend/app/core/config.py
CORS_ORIGINS=https://your_frontend_origin_here.example.com

# Public frontend URL used in password-reset links; validated against localhost in production.
# REQUIRED, no default found — app fails ValidationError at import time without it — backend/app/api/auth.py via backend/app/core/config.py
FRONTEND_URL=https://your_frontend_here.example.com

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Optional full DSN override; wins over individual DB_* fields (e.g. mysql+pymysql://... ) — backend/app/core/config.py:168
DATABASE_URL=your_database_url_here

# SQLAlchemy driver: "mysql+pymysql" or "sqlite" — backend/app/core/config.py:183
DB_DRIVER=mysql+pymysql

# Database host (required in production validator) — backend/app/core/database.py via backend/app/core/config.py
DB_HOST=your_db_host_here

# Database port (default 3306; required non-empty in production) — backend/app/core/config.py
DB_PORT=3306

# Database user (required in production validator) — backend/app/core/config.py
DB_USER=your_db_user_here

# Database password (required in production validator) — backend/app/core/config.py
DB_PASSWORD=your_db_password_here

# Database name (required in production validator) — backend/app/core/config.py
DB_NAME=your_db_name_here

# Optional root that redirects ALL ML artifacts + validation DB elsewhere — backend/app/core/config.py:476
TEMP_VALIDATION_ROOT=

# Optional override of the validation database name — backend/app/core/config.py:492
VALIDATION_DB_NAME=

# Optional override of the SQLite file used when DB_DRIVER=sqlite — backend/app/core/config.py:496
VALIDATION_SQLITE_PATH=

# ------------------------------------------------------------
# Secrets / Auth
# ------------------------------------------------------------

# JWT signing secret. MUST be long & random; production guard rejects known defaults.
# REQUIRED, no default found — app fails ValidationError at import time without it — backend/app/core/security.py via backend/app/core/config.py:75
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# JWT algorithm — backend/app/core/security.py via backend/app/core/config.py:268
ALGORITHM=HS256

# Access-token lifetime in minutes — backend/app/core/security.py via backend/app/core/config.py
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh-token lifetime in minutes — backend/app/core/security.py via backend/app/core/config.py
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# SMTP server host for password-reset emails (only used in production) — backend/app/utils/email.py via backend/app/core/config.py
SMTP_HOST=your_smtp_host_here

# SMTP port — backend/app/utils/email.py via backend/app/core/config.py
SMTP_PORT=587

# SMTP username — backend/app/utils/email.py via backend/app/core/config.py
SMTP_USERNAME=your_smtp_username_here

# SMTP password — backend/app/utils/email.py via backend/app/core/config.py
SMTP_PASSWORD=your_smtp_password_here

# From address on reset emails — backend/app/utils/email.py via backend/app/core/config.py
SMTP_FROM_EMAIL=no-reply@your_domain_here.example.com

# Use STARTTLS — backend/app/utils/email.py via backend/app/core/config.py
SMTP_USE_TLS=true

# HuggingFace token for private model repos (empty => hub downloads skipped) — backend/app/services/hub_downloader.py, streamlit_app.py via backend/app/core/config.py:367
HF_TOKEN=your_hf_token_here

# ------------------------------------------------------------
# ML Models
# ------------------------------------------------------------

# Root dir for all ML artifacts — backend/app/core/config.py:344
ML_DIR=app/ml

# Root dir for datasets — backend/app/core/config.py:345
DATASETS_DIR=app/datasets

# XGBoost TF-DF model directory — backend/app/services/xgboost_service.py, backend/app/api/ml.py via backend/app/core/config.py:350
XGB_MODEL_PATH=app/ml/xgb_tfdf

# Pickled TF-IDF vectorizer for XGBoost — backend/app/core/config.py:351
XGB_TFIDF_VECTORIZER_PATH=app/ml/tfidf_vectorizer_xgb.pkl

# Pickled label encoder for XGBoost — backend/app/core/config.py:352
XGB_LABEL_ENCODER_PATH=app/ml/label_encoder_xgb.pkl

# mDeBERTa model directory — backend/app/services/deberta_service.py, backend/app/api/ml.py via backend/app/core/config.py:353
MDEBERTA_MODEL_PATH=app/ml/mdeberta_v3

# XLM-RoBERTa model directory — backend/app/services/roberta_service.py, backend/app/api/ml.py via backend/app/core/config.py:354
XLM_ROBERTA_MODEL_PATH=app/ml/xlm_roberta_sentiment

# Deployment metadata JSON path — backend/app/api/ml.py, backend/app/services/training.py via backend/app/core/config.py:356
MODEL_METADATA_PATH=app/ml/model_metadata.json

# Model-comparison results JSON path — backend/app/services/training.py via backend/app/core/config.py:357
COMPARISON_RESULTS_PATH=app/ml/comparison_results.json

# Private HF repo: XLM-RoBERTa artifacts — backend/app/services/hub_downloader.py via backend/app/core/config.py:372
HF_XLM_ROBERTA_REPO=your_xlmr_repo_here

# Private HF repo: mDeBERTa artifacts — backend/app/services/hub_downloader.py via backend/app/core/config.py:373
HF_MDEBERTA_REPO=your_mdeberta_repo_here

# Private HF repo: XGBoost TF-IDF artifacts — backend/app/core/config.py:374
HF_XGB_TFIDF_REPO=your_xgb_repo_here

# Private HF repo: MiniLM artifacts (the live model) — backend/app/services/hub_downloader.py, streamlit_app.py via backend/app/core/config.py:375
HF_MINILM_REPO=your_minilm_repo_here

# Approach name registered as production after hub pull — backend/app/core/config.py:382
HF_PRODUCTION_MODEL=Multilingual MiniLM

# Quantized mDeBERTa weight filename in its HF repo — backend/app/core/config.py:388
MDEBERTA_QUANTIZED_FILE=mdeberta_quantized_v2.pt

# Quantized XLM-R weight filename in its HF repo — backend/app/core/config.py:389
XLM_ROBERTA_QUANTIZED_FILE=xlmr_quantized_v2.pt

# ONNX filename for MiniLM — backend/app/services/hub_downloader.py, backend/app/services/minilm_service.py via backend/app/core/config.py:392
MINILM_ONNX_FILE=model.onnx

# HF checkpoint id for XLM-RoBERTa — backend/app/core/config.py:396
XLM_ROBERTA_MODEL_NAME=xlm-roberta-base

# HF checkpoint id for mDeBERTa — backend/app/core/config.py:397
MDEBERTA_MODEL_NAME=microsoft/mdeberta-v3-base

# HF checkpoint id for MiniLM — backend/app/core/config.py:402
MINILM_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Local MiniLM artifact directory — backend/app/services/minilm_service.py via backend/app/core/config.py:403
MINILM_MODEL_PATH=app/ml/minilm_sentiment

# Max sequence length for MiniLM — backend/app/services/minilm_service.py via backend/app/core/config.py:404
MINILM_MAX_SEQ_LENGTH=128

# Feature flag: false disables MiniLM inference everywhere (503) — backend/app/services/minilm_service.py via backend/app/core/config.py:417
ENABLE_MINILM_INFERENCE=true

# RAM guard: refuse MiniLM inference below this host memory (0 = disabled) — backend/app/services/minilm_service.py via backend/app/core/config.py:418
MINILM_MIN_RAM_MB=900

# Optional manual override of detected host RAM for the guard — backend/app/core/config.py:424
MINILM_HOST_RAM_MB=

# Torch device for transformers — backend/app/core/config.py:426
TRANSFORMER_DEVICE=cpu

# Random seed for training splits — backend/app/services/training.py via backend/app/core/config.py:428
RANDOM_STATE=42

# Train/test split fraction — backend/app/services/training.py via backend/app/core/config.py:429
TEST_SIZE=0.2

# JSON dict of ensemble weights (approved: mDeBERTa + XLM-RoBERTa) — backend/app/core/config.py:437
ENSEMBLE_WEIGHTS={"mDeBERTa": 0.5, "XLM-RoBERTa": 0.5}

# Bootstrap iterations for evaluation — backend/app/core/config.py:441
BOOTSTRAP_N_ITER=1000

# Bootstrap confidence level — backend/app/core/config.py:442
BOOTSTRAP_ALPHA=0.05

# Bootstrap seed — backend/app/core/config.py:443
BOOTSTRAP_SEED=42

# mDeBERTa fine-tune epochs — backend/app/core/config.py:447
MDEBERTA_EPOCHS=3

# mDeBERTa fine-tune batch size — backend/app/core/config.py:448
MDEBERTA_BATCH_SIZE=8

# mDeBERTa learning rate — backend/app/core/config.py:449
MDEBERTA_LEARNING_RATE=0.00002

# mDeBERTa weight decay — backend/app/core/config.py:450
MDEBERTA_WEIGHT_DECAY=0.01

# mDeBERTa warmup ratio — backend/app/core/config.py:451
MDEBERTA_WARMUP_RATIO=0.1

# mDeBERTa max sequence length — backend/app/core/config.py:452
MDEBERTA_MAX_SEQ_LENGTH=256

# XGBoost n_estimators — backend/app/core/config.py:456
XGB_N_ESTIMATORS=300

# XGBoost max depth — backend/app/core/config.py:457
XGB_MAX_DEPTH=6

# XGBoost learning rate — backend/app/core/config.py:458
XGB_LEARNING_RATE=0.1

# Feature flag: stopword removal in preprocessing (default off) — backend/app/services/preprocessing.py via backend/app/core/config.py:462
PREPROCESSING_REMOVE_STOPWORDS=false

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Log directory (created at startup) — backend/app/utils/logger.py via backend/app/core/config.py:467
LOG_DIR=logs

# Log level — backend/app/utils/logger.py via backend/app/core/config.py:468
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Streamlit front-end only (root streamlit_app.py — NOT the backend API)
# ------------------------------------------------------------

# HF repo id for the Streamlit app's MiniLM snapshot — streamlit_app.py:29
MODEL_REPO=your_streamlit_model_repo_here

# Explicit local path to MiniLM ONNX artifact folder (skips download) — streamlit_app.py:50
MINILM_LOCAL_DIR=

