# Ship the small XGBoost/TF-IDF artifacts with the app (see root .gitignore):
# production needs them at boot, and Render's disk is ephemeral. The ~1GB
# transformer checkpoints remain ignored.
app/ml/*
!app/ml/comparison_results.json
!app/ml/model_metadata.json
!app/ml/xgb_model.pkl
!app/ml/xgb_model.json
!app/ml/xgb_tfdf
!app/ml/tfidf_vectorizer_xgb.pkl
!app/ml/label_encoder_xgb.pkl
backend/app/training_outputs/

node_modules/

# Local/temporary datasets - do not publish
backend/app/datasets/*SYNTHETIC*.csv
backend/app/datasets/*student_analysis_feedback*.csv
backend/app/datasets/*student_prediction_sample*.csv

# Unnecessary local test files
backend/filename.ext
backend/check_db.py
backend/test_api.py
backend/test_login.py

# Student feedback datasets - keep private
backend/app/datasets/*_feedback.csv