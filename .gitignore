# ML artifacts: only the small metrics files are committed so the admin panel
# has data on a fresh deploy (the Render disk is ephemeral). Model weights are
# pulled from the private Hugging Face Hub repo at startup, and the large
# checkpoints stay ignored (GitHub hard-limits files >100MB).
backend/app/ml/*
!backend/app/ml/comparison_results.json
!backend/app/ml/model_metadata.json
backend/app/training_outputs/

node_modules/

# Local datasets and temporary files
backend/app/datasets/*SYNTHETIC*.csv
backend/app/datasets/*student_analysis_feedback*.csv
backend/app/datasets/*student_prediction_sample*.csv
backend/filename.ext
backend/check_db.py
backend/test_api.py
backend/test_login.py
backend/venv/
